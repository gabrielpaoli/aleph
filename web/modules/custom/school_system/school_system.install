<?php

/**
 * @file
 * Install, update and uninstall functions for the School System module.
 */

use Drupal\node\Entity\NodeType;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;
use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implements hook_schema().
 */
function school_system_schema() {
  $schema['school_system_attendance'] = [
    'description' => 'Lightweight attendance records (replaces attendance nodes).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'student_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Node ID of the student.',
      ],
      'date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'description' => 'Date in YYYY-MM-DD format.',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'present',
        'description' => 'present, absent, half_absent.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp of creation.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'student_date' => ['student_id', 'date'],
    ],
    'indexes' => [
      'student_id' => ['student_id'],
      'date' => ['date'],
      'status' => ['status'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function school_system_install() {
  // Crear Content Types
  _school_system_create_content_types();

  // Crear campos
  _school_system_create_fields();

  // Crear roles
  _school_system_create_roles();

  // Asignar permisos a roles
  _school_system_assign_permissions();

  // Crear campo de materias para usuarios
  _school_system_create_user_subjects_field();

  \Drupal::messenger()->addStatus(t('School System module installed successfully.'));
}

/**
 * Crear Content Types.
 */
function _school_system_create_content_types() {
  $types = [
    'course' => [
      'name' => 'Course',
      'description' => 'Curso',
    ],
    'subject' => [
      'name' => 'Subject',
      'description' => 'Materia',
    ],
    'student' => [
      'name' => 'Student',
      'description' => 'Estudiante',
    ],
    'teacher' => [
      'name' => 'Teacher',
      'description' => 'Docente',
    ],
    'attendance' => [
      'name' => 'Attendance',
      'description' => 'Asistencia',
    ],
    'grade' => [
      'name' => 'Grade',
      'description' => 'Calificación',
    ],
    'note' => [
      'name' => 'Note',
      'description' => 'Nota para Padres',
    ],
    'excluded_date' => [
      'name' => 'Excluded Date',
      'description' => 'Día excluido del calendario de asistencias',
    ],
    'subject_enrollment' => [
      'name' => 'Subject Enrollment',
      'description' => 'Estado de materia por estudiante',
    ],
    'advance_year_decision' => [
      'name' => 'Advance Year Decision',
      'description' => 'Decision manual de avance de ano',
    ],
    'period_grade' => [
      'name' => 'Period Grade',
      'description' => 'Notas de cierre de trimestres y final',
    ],
  ];

  foreach ($types as $type_id => $type_info) {
    if (!NodeType::load($type_id)) {
      $node_type = NodeType::create([
        'type' => $type_id,
        'name' => $type_info['name'],
        'description' => $type_info['description'],
        'new_revision' => FALSE,
      ]);
      $node_type->save();
    }
  }
}

