<?php

/**
 * @file
 * School System module file.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function school_system_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.school_system':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('School System provides a complete API for managing students, courses, attendance, and grades.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_mail().
 */
function school_system_mail($key, &$message, $params) {
  // Ensure headers array exists
  if (!isset($message['headers'])) {
    $message['headers'] = [];
  }
  
  $message['headers']['Content-Type'] = 'text/plain; charset=UTF-8';

  switch ($key) {
    case 'absence_notification':
      $message['subject'] = $params['subject'] ?? 'Notificación de Ausencia';
      $message['body'][] = $params['body'] ?? '';
      break;

    case 'note_notification':
      $message['subject'] = t('Nota de @author para @student', [
        '@author' => $params['author_name'] ?? 'Docente',
        '@student' => $params['student_name'] ?? 'Estudiante',
      ]);
      $message['body'][] = t('Título: @title', ['@title' => $params['note_title'] ?? '']);
      $message['body'][] = '';
      $message['body'][] = t('Contenido:');
      $message['body'][] = $params['note_content'] ?? '';
      $message['body'][] = '';
      $message['body'][] = t('De: @author', ['@author' => $params['author_name'] ?? 'Docente']);
      break;

    case 'password_reset':
      $account = $params['account'];
      $reset_url = $params['reset_url'];
      $message['subject'] = t('Restablecer contraseña — Sistema Escolar');
      $message['body'][] = t('Hola @name,', ['@name' => $account->getDisplayName()]);
      $message['body'][] = '';
      $message['body'][] = t('Recibimos una solicitud para restablecer la contraseña de tu cuenta.');
      $message['body'][] = t('Hacé clic en el siguiente enlace para crear una nueva contraseña (válido por 24 horas):');
      $message['body'][] = '';
      $message['body'][] = $reset_url;
      $message['body'][] = '';
      $message['body'][] = t('Si no solicitaste este cambio, podés ignorar este correo.');
      $message['body'][] = '';
      $message['body'][] = t('— Sistema Escolar');
      break;
  }
}

/**
 * Implements hook_page_attachments().
 */
function school_system_page_attachments(array &$attachments) {
  // Agregar headers CORS
  $attachments['#attached']['http_header'][] = ['Access-Control-Allow-Origin', '*'];
  $attachments['#attached']['http_header'][] = ['Access-Control-Allow-Methods', 'GET, POST, PATCH, DELETE, OPTIONS'];
  $attachments['#attached']['http_header'][] = ['Access-Control-Allow-Headers', 'Content-Type, Authorization'];
}
